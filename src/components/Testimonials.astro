---
const testimonials = [
    {
        name: "Mg.Nélida Orbegoso Valverde",
        specialty: "Especialista en Teología Espiritual",
        text: "La Dra Nos cuenta su trayectoria como docente y su experiencia trabajando con Elías Capellán.",
        img: "/imagenes/testimonios/testimonios11.png",
        video: "https://www.youtube.com/watch?v=TKRSTjvHW-U"
    },
];
---
<section class="py-24 bg-slate-50 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16" data-aos="fade-up">
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-4">
                Lo que dicen nuestros <span class="text-gradient">Estudiantes</span>
            </h2>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                Historias reales de éxito y transformación profesional de quienes confiaron en nuestra metodología.
            </p>
        </div>

        <div class="max-w-4xl mx-auto" data-aos="zoom-in">
            {testimonials.map((t) => (
                <div class="premium-card flex flex-col md:flex-row items-center gap-10 !p-12 relative">
                    <div class="absolute top-8 left-8 text-6xl text-brand-100 font-serif leading-none select-none">“</div>
                    
                    <div class="relative w-48 h-48 flex-shrink-0">
                        <div class="absolute inset-0 bg-brand-200 rounded-3xl rotate-6 transition-transform group-hover:rotate-12 duration-500"></div>
                        <img class="relative w-full h-full object-cover rounded-3xl shadow-xl shadow-brand-500/20" src={t.img} alt={t.name} loading="lazy" />
                    </div>

                    <div class="flex-1 text-center md:text-left">
                        <p class="text-xl md:text-2xl text-slate-700 italic mb-8 leading-relaxed font-medium">
                            "{t.text}"
                        </p>
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                            <div>
                                <h4 class="text-xl font-bold text-slate-900 leading-tight">{t.name}</h4>
                                <span class="text-brand-600 font-semibold text-sm">{t.specialty}</span>
                            </div>
                            <a href={t.video} target="_blank" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 text-white text-sm font-bold hover:bg-brand-600 transition-colors">
                                <i class="fa fa-play-circle text-lg"></i>
                                Ver Video Testimonio
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

