---
const contactInfo = [
    {
        icon: "fa-map-marker-alt",
        title: "Ubicación",
        details: "Calle Principal 123, Centro Profesional, Ciudad Capital",
        link: "#"
    },
    {
        icon: "fa-phone-alt",
        title: "Teléfono",
        details: "+1 (555) 123-4567 / +1 (555) 123-4568",
        link: "tel:+15551234567"
    },
    {
        icon: "fa-envelope",
        title: "Email",
        details: "info@eliascapellan.edu / contacto@eliascapellan.edu",
        link: "mailto:info@eliascapellan.edu"
    },
    {
        icon: "fa-clock",
        title: "Horario",
        details: "Lun - Vie: 8:00 AM - 6:00 PM | Sab: 9:00 AM - 1:00 PM",
        link: "#"
    },
];

const socialLinks = [
    { icon: "fa-facebook-f", link: "#", label: "Facebook" },
    { icon: "fa-twitter", link: "#", label: "Twitter" },
    { icon: "fa-linkedin-in", link: "#", label: "LinkedIn" },
    { icon: "fa-instagram", link: "#", label: "Instagram" },
    { icon: "fa-youtube", link: "#", label: "YouTube" },
];
---

<section id="contacto" class="py-24 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-brand-maroon-500/5 rounded-full -ml-48 -mt-48 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-orange-500/5 rounded-full -mr-48 -mb-48 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="inline-block px-4 py-1.5 rounded-full bg-brand-orange-50 border border-brand-orange-200 text-brand-maroon-950 text-xs font-bold uppercase tracking-widest mb-6">
                Contacto
            </span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6">
                Ponte en <span class="text-gradient">Contacto Ahora</span>
            </h2>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                Estamos aquí para ayudarte con cualquier pregunta sobre nuestros programas y servicios.
            </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-12 mb-20">
            <!-- Contact Form -->
            <div class="lg:col-span-2" data-aos="fade-right">
                <div class="bg-white rounded-3xl p-8 md:p-12 shadow-lg border border-slate-200">
                    <form class="space-y-6">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-bold text-slate-900 mb-2">Nombre Completo</label>
                                <input type="text" placeholder="Juan Pérez" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:border-brand-orange-500 focus:ring-2 focus:ring-brand-orange-100 transition-all" />
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-slate-900 mb-2">Email</label>
                                <input type="email" placeholder="juan@ejemplo.com" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:border-brand-orange-500 focus:ring-2 focus:ring-brand-orange-100 transition-all" />
                            </div>
                        </div>

                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-bold text-slate-900 mb-2">Teléfono</label>
                                <input type="tel" placeholder="+1 (555) 000-0000" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:border-brand-orange-500 focus:ring-2 focus:ring-brand-orange-100 transition-all" />
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-slate-900 mb-2">Programa de Interés</label>
                                <select class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:border-brand-orange-500 focus:ring-2 focus:ring-brand-orange-100 transition-all">
                                    <option>Selecciona un programa</option>
                                    <option>Diplomados</option>
                                    <option>Especialización</option>
                                    <option>Preparación</option>
                                    <option>Actualización</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-900 mb-2">Mensaje</label>
                            <textarea placeholder="Cuéntanos cómo podemos ayudarte..." rows="6" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:outline-none focus:border-brand-orange-500 focus:ring-2 focus:ring-brand-orange-100 transition-all resize-none"></textarea>
                        </div>

                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="privacy" class="mt-1 w-4 h-4 rounded border-slate-300 text-brand-maroon-950 focus:ring-brand-maroon-500" />
                            <label for="privacy" class="text-sm text-slate-600">
                                Acepto la <a href="#" class="text-brand-maroon-700 font-bold hover:underline">política de privacidad</a> y términos de servicio
                            </label>
                        </div>

                        <button type="submit" class="w-full py-4 rounded-2xl bg-gradient-to-r from-brand-maroon-950 to-brand-maroon-900 text-white font-bold text-lg hover:shadow-lg hover:-translate-y-1 transition-all active:scale-95">
                            Enviar Mensaje
                        </button>
                    </form>
                </div>
            </div>

            <!-- Contact Info -->
            <div class="space-y-6" data-aos="fade-left">
                {contactInfo.map((info, index) => (
                    <a href={info.link} class="group block p-6 rounded-2xl bg-white border border-slate-200 hover:border-brand-orange-300 hover:shadow-lg transition-all duration-300">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-orange-400 to-brand-maroon-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                <i class={`fa ${info.icon} text-white text-lg`}></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 mb-1">{info.title}</h4>
                                <p class="text-slate-600 text-sm leading-relaxed">{info.details}</p>
                            </div>
                        </div>
                    </a>
                ))}

                <!-- Social Media -->
                <div class="pt-6 border-t border-slate-200">
                    <p class="font-bold text-slate-900 mb-4">Síguenos en Redes Sociales</p>
                    <div class="flex gap-3">
                        {socialLinks.map(social => (
                            <a href={social.link} title={social.label} class="w-10 h-10 rounded-full bg-brand-maroon-950 text-white flex items-center justify-center hover:bg-brand-orange-500 transition-colors">
                                <i class={`fa ${social.icon} text-sm`}></i>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <!-- Map Section -->
        <div class="rounded-3xl overflow-hidden shadow-2xl h-96 bg-gradient-to-br from-slate-200 to-slate-300 flex items-center justify-center" data-aos="fade-up">
            <div class="text-center text-slate-600">
                <i class="fa fa-map text-6xl opacity-30 mb-4 block"></i>
                <p class="font-bold">Mapa interactivo - Ubicación de nuestro centro</p>
            </div>
        </div>
    </div>
</section>
