---
const sliders = [
    { img: "/imagenes/banner/slider_1665597581.jpg" },
    { img: "/imagenes/banner/slider_1665597451.jpg" },
];

import HeroSlider from "./HeroSlider.jsx";
---
<section class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden">
    <!-- Background Slider React (client:load) -->
    <HeroSlider sliders={sliders} client:load />

    <div class="max-w-7xl mx-auto px-6 relative z-20">
        <div class="max-w-3xl" data-aos="fade-up">
            <span class="inline-block px-4 py-1.5 rounded-full bg-brand-maroon-500/10 border border-brand-maroon-500/20 text-brand-orange-400 text-xs font-bold uppercase tracking-widest mb-6">
                Líderes en Capacitación
            </span>
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white leading-[1.1] mb-8">
                Impulsa tu <br/>
                <span class="text-gradient brightness-125">Futuro Profesional</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed max-w-2xl">
                Programas de formación especializada diseñados para transformar tu carrera. Aprende de expertos y obtén certificaciones con respaldo académico.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
                <a href="#programas" class="btn-primary">
                    Ver Programas
                </a>
                <a href="/nosotros" class="btn-secondary !bg-white/10 !text-white !border-white/20 backdrop-blur-sm hover:!bg-white/20">
                    Más Información
                </a>
            </div>
        </div>
    </div>

    <!-- Floating Decorative Elements -->
    <div class="absolute right-0 bottom-0 w-1/3 h-1/3 bg-brand-orange-500/10 blur-[120px] rounded-full -z-10"></div>
</section>



