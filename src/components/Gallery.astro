---
const galleryItems = [
    { title: "Ceremonia de Graduación", img: "/imagenes/galeria/grad1.jpg", category: "Eventos" },
    { title: "Clase Magistral", img: "/imagenes/galeria/class1.jpg", category: "Académico" },
    { title: "Taller Práctico", img: "/imagenes/galeria/workshop1.jpg", category: "Talleres" },
    { title: "Conferencia Internacional", img: "/imagenes/galeria/conf1.jpg", category: "Eventos" },
    { title: "Laboratorio Virtual", img: "/imagenes/galeria/lab1.jpg", category: "Académico" },
    { title: "Networking Session", img: "/imagenes/galeria/network1.jpg", category: "Talleres" },
    { title: "Premiación de Excelencia", img: "/imagenes/galeria/award1.jpg", category: "Eventos" },
    { title: "Sesión de Mentoría", img: "/imagenes/galeria/mentor1.jpg", category: "Académico" },
];

const categories = ["Todos", "Académico", "Talleres", "Eventos"];
---

<section id="galeria" class="py-24 relative overflow-hidden bg-slate-50">
    <!-- Background decoration -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-orange-500/5 rounded-full -mr-48 -mt-48 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-maroon-500/5 rounded-full -ml-48 -mb-48 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="inline-block px-4 py-1.5 rounded-full bg-brand-orange-50 border border-brand-orange-200 text-brand-maroon-950 text-xs font-bold uppercase tracking-widest mb-6">
                Galería
            </span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6">
                Momentos que <span class="text-gradient">Inspiran</span>
            </h2>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                Vive los mejores momentos de nuestro centro de capacitación y comunidad educativa.
            </p>
        </div>

        <!-- Category Filter -->
        <div class="flex flex-wrap justify-center gap-4 mb-16" data-aos="fade-up">
            {categories.map(cat => (
                <button class={`px-6 py-2.5 rounded-full font-bold transition-all ${
                    cat === "Todos"
                        ? "bg-brand-maroon-950 text-white shadow-lg"
                        : "bg-white border border-slate-200 text-slate-700 hover:border-brand-orange-300 hover:text-brand-orange-600"
                }`}>
                    {cat}
                </button>
            ))}
        </div>

        <!-- Gallery Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            {galleryItems.map((item, index) => (
                <div class="group relative h-64 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer hover:-translate-y-1" data-aos="fade-up" data-aos-delay={index * 50}>
                    <!-- Image Placeholder -->
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-orange-400 to-brand-maroon-600 flex items-center justify-center">
                        <i class="fa fa-image text-white text-4xl opacity-30"></i>
                    </div>

                    <!-- Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                    <!-- Content -->
                    <div class="absolute inset-0 flex flex-col justify-end p-6 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                        <span class="text-xs font-bold text-brand-orange-300 uppercase tracking-widest mb-2 opacity-0 group-hover:opacity-100 transition-opacity delay-75">
                            {item.category}
                        </span>
                        <h3 class="text-white font-bold text-lg leading-tight">
                            {item.title}
                        </h3>
                    </div>
                </div>
            ))}
        </div>

        <!-- View More Button -->
        <div class="text-center" data-aos="fade-up">
            <a href="/galeria" class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-brand-maroon-950 text-white font-bold hover:bg-brand-maroon-900 transition-all hover:shadow-xl hover:-translate-y-1">
                Ver Galería Completa
                <i class="fa fa-arrow-right text-sm"></i>
            </a>
        </div>
    </div>
</section>
