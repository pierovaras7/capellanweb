---
import '../styles/global.css';
const { title = "Elias Capellan" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Centro de capacitación | Elias Capellan" />
    <meta name="keywords" content="academia, curso, educación, programa, diplomado, utc, elearning, learning, erp elias capellan" />
    <meta name="author" content="Edwin Jonathan Segundo Chavez" />
    <link rel="icon" href="/favicon.ico">
    <title>{title}</title>
 
    <!-- Premium Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Animations -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <slot name="css" />
</head>
<body class="bg-slate-50 text-slate-900 overflow-x-hidden">
    <div class="relative min-h-screen flex flex-col">
        <!-- Abstract Background Shapes -->
        <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
            <div class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] bg-brand-200/20 blur-[120px] rounded-full"></div>
            <div class="absolute top-[20%] -right-[10%] w-[40%] h-[40%] bg-indigo-200/20 blur-[100px] rounded-full"></div>
            <div class="absolute -bottom-[10%] left-[20%] w-[60%] h-[50%] bg-blue-100/30 blur-[150px] rounded-full"></div>
        </div>

        <slot />
    </div>

    <!-- Scripts -->
    <script is:inline src="https://kit.fontawesome.com/056349dcae.js" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
             // AOS Initialization
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 800,
                    once: true,
                    offset: 50,
                });
            }
        });
    </script>
    <slot name="script" />
</body>
</html>

<style is:global>
    /* Custom scrollbar for premium feel */
    ::-webkit-scrollbar {
        width: 10px;
    }
    ::-webkit-scrollbar-track {
        @apply bg-slate-100;
    }
    ::-webkit-scrollbar-thumb {
        @apply bg-slate-300 rounded-full border-2 border-slate-100 hover:bg-slate-400;
    }
</style>

