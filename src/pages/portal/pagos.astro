---
import Layout from '../../layouts/Layout.astro';

const payments = [
    { period: "Enero 2024", amount: 450, status: "Pagado", date: "05 Ene 2024", method: "Transferencia" },
    { period: "Febrero 2024", amount: 450, status: "Pagado", date: "15 Feb 2024", method: "Tarjeta" },
    { period: "Marzo 2024", amount: 450, status: "Pagado", date: "10 Mar 2024", method: "Transferencia" },
    { period: "Abril 2024", amount: 450, status: "Pagado", date: "20 Abr 2024", method: "Tarjeta" },
    { period: "Mayo 2024", amount: 450, status: "Pagado", date: "12 May 2024", method: "Transferencia" },
    { period: "Junio 2024", amount: 450, status: "Vencido", date: "30 Jun 2024", method: "Pendiente" },
];
---

<Layout title="Pagos | Portal de Estudiantes">
    <div class="min-h-screen bg-white">

        <!-- Header -->
        <header class="bg-brand-orange-500 sticky top-0 z-40 shadow-md">
            <div class="max-w-7xl mx-auto flex items-center justify-between px-4 md:px-6 py-4">
                <div class="flex items-center gap-4">
                    <a href="/portal/dashboard" class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors text-white">
                        <i class="fa fa-arrow-left text-lg"></i>
                    </a>
                    <h1 class="text-xl font-bold text-white">Gestión de Pagos</h1>
                </div>
                <button id="logoutBtn" class="px-4 py-2 rounded-lg text-white font-semibold text-sm hover:bg-white/10 transition-colors border border-white/20">
                    Salir
                </button>
            </div>
        </header>

        <main class="w-full p-4 md:p-8 overflow-x-hidden max-w-6xl mx-auto">
            <!-- Summary Cards -->
            <div class="grid md:grid-cols-3 gap-6 mb-8">
                <div class="group relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl opacity-0 group-hover:opacity-100 blur transition-all duration-300"></div>
                    <div class="relative bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg transition-all">
                        <p class="text-slate-600 text-sm font-semibold mb-3">Total Pagado</p>
                        <p class="text-4xl font-black text-slate-900">S/. 2,250</p>
                        <p class="text-xs text-slate-500 mt-3">5 cuotas completadas</p>
                    </div>
                </div>

                <div class="group relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl opacity-0 group-hover:opacity-100 blur transition-all duration-300"></div>
                    <div class="relative bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg transition-all">
                        <p class="text-slate-600 text-sm font-semibold mb-3">Pendiente de Pago</p>
                        <p class="text-4xl font-black text-red-600">S/. 450</p>
                        <p class="text-xs text-red-600 mt-3">Vence: 30 Jun 2024</p>
                    </div>
                </div>

                <div class="group relative">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-orange-500 to-brand-orange-600 rounded-2xl opacity-0 group-hover:opacity-100 blur transition-all duration-300"></div>
                    <div class="relative bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg transition-all">
                        <p class="text-slate-600 text-sm font-semibold mb-3">Próxima Cuota</p>
                        <p class="text-4xl font-black text-brand-orange-500">S/. 450</p>
                        <p class="text-xs text-slate-500 mt-3">Julio 2024</p>
                    </div>
                </div>
            </div>

            <!-- Alert -->
            <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-lg mb-8">
                <div class="flex items-start gap-4">
                    <i class="fa fa-exclamation-circle text-red-600 text-2xl mt-1 flex-shrink-0"></i>
                    <div>
                        <p class="font-bold text-red-900">Pago Vencido</p>
                        <p class="text-sm text-red-700 mt-2">Tienes una cuota vencida por S/. 450. Por favor realiza el pago lo antes posible para evitar atrasos en tu programa.</p>
                        <button class="mt-4 px-6 py-2.5 bg-red-600 text-white font-bold text-sm rounded-lg hover:bg-red-700 transition-colors">
                            <i class="fa fa-credit-card mr-2"></i> Pagar Ahora
                        </button>
                    </div>
                </div>
            </div>

            <!-- Historial de Pagos -->
            <div class="relative group mb-8">
                <div class="absolute inset-0 bg-gradient-to-r from-brand-orange-500/20 to-brand-maroon-500/20 rounded-2xl blur-xl group-hover:from-brand-orange-500/30 group-hover:to-brand-maroon-500/30 transition-all"></div>
                <div class="relative bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all">
                    <div class="p-8 border-b border-slate-200">
                        <h2 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                            <i class="fa fa-history text-brand-orange-500"></i> Historial de Pagos
                        </h2>
                        <p class="text-slate-600 mt-2">Detalle de todas tus transacciones</p>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-slate-50 border-b border-slate-200">
                                <tr>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-slate-900">Período</th>
                                    <th class="px-6 py-4 text-center text-sm font-bold text-slate-900">Monto</th>
                                    <th class="px-6 py-4 text-center text-sm font-bold text-slate-900">Estado</th>
                                    <th class="px-6 py-4 text-center text-sm font-bold text-slate-900">Fecha</th>
                                    <th class="px-6 py-4 text-center text-sm font-bold text-slate-900">Método</th>
                                    <th class="px-6 py-4 text-center text-sm font-bold text-slate-900">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                {payments.map((payment, index) => {
                                    const statusColor = payment.status === "Pagado" ? "bg-green-100 text-green-700 border border-green-300" : payment.status === "Vencido" ? "bg-red-100 text-red-700 border border-red-300" : "bg-yellow-100 text-yellow-700 border border-yellow-300";
                                    const statusIcon = payment.status === "Pagado" ? "fa-check-circle" : payment.status === "Vencido" ? "fa-times-circle" : "fa-clock";

                                    return (
                                        <tr class={index % 2 === 0 ? "bg-white" : "bg-slate-50"}>
                                            <td class="px-6 py-4 text-sm font-bold text-slate-900 border-b border-slate-200">
                                                {payment.period}
                                            </td>
                                            <td class="px-6 py-4 text-center text-sm font-bold text-slate-900 border-b border-slate-200">
                                                S/. {payment.amount}
                                            </td>
                                            <td class="px-6 py-4 text-center border-b border-slate-200">
                                                <span class={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold ${statusColor}`}>
                                                    <i class={`fa ${statusIcon}`}></i>
                                                    {payment.status}
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-center text-sm text-slate-600 border-b border-slate-200">
                                                {payment.date}
                                            </td>
                                            <td class="px-6 py-4 text-center text-sm text-slate-600 border-b border-slate-200">
                                                {payment.method}
                                            </td>
                                            <td class="px-6 py-4 text-center border-b border-slate-200">
                                                {payment.status === "Pagado" ? (
                                                    <a href="#" class="text-xs font-bold text-brand-orange-600 hover:text-brand-orange-700 transition-colors">
                                                        Comprobante
                                                    </a>
                                                ) : (
                                                    <button class="text-xs font-bold text-brand-orange-600 hover:text-brand-orange-700 transition-colors">
                                                        Pagar
                                                    </button>
                                                )}
                                            </td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Métodos de Pago -->
            <div class="relative group mb-8">
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-2xl blur-xl group-hover:from-blue-500/30 group-hover:to-purple-500/30 transition-all"></div>
                <div class="relative bg-white border border-slate-200 rounded-2xl p-8 hover:shadow-lg transition-all">
                    <h3 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
                        <i class="fa fa-wallet text-blue-600"></i> Métodos de Pago
                    </h3>

                    <div class="grid md:grid-cols-2 gap-6 mb-6">
                        <div class="p-6 rounded-lg border-2 border-slate-200 hover:border-blue-300 cursor-pointer transition-all bg-slate-50">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-3">
                                    <i class="fa fa-university text-3xl text-blue-600"></i>
                                    <div>
                                        <p class="font-bold text-slate-900">Transferencia Bancaria</p>
                                        <p class="text-xs text-slate-500">BCP / Interbank / Scotiabank</p>
                                    </div>
                                </div>
                                <i class="fa fa-check-circle text-green-600 text-xl"></i>
                            </div>
                            <p class="text-xs text-slate-600 bg-white p-3 rounded border border-slate-200">
                                Cuenta: 12345678 | CCI: 0021234567890123456789
                            </p>
                        </div>

                        <div class="p-6 rounded-lg border-2 border-slate-200 hover:border-brand-orange-300 cursor-pointer transition-all bg-slate-50">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-3">
                                    <i class="fa fa-credit-card text-3xl text-brand-orange-600"></i>
                                    <div>
                                        <p class="font-bold text-slate-900">Tarjeta de Crédito</p>
                                        <p class="text-xs text-slate-500">Visa / Mastercard / Amex</p>
                                    </div>
                                </div>
                            </div>
                            <button class="w-full text-sm font-bold text-brand-orange-600 hover:text-brand-orange-700 transition-colors py-2 border border-brand-orange-300 rounded-lg hover:bg-brand-orange-50 hover:border-brand-orange-400">
                                Pagar con Tarjeta
                            </button>
                        </div>
                    </div>

                    <button class="w-full py-3 rounded-lg bg-brand-maroon-950 text-white font-bold hover:bg-brand-maroon-900 transition-colors">
                        <i class="fa fa-download mr-2"></i> Descargar Comprobante de Matrícula
                    </button>
                </div>
            </div>

            <!-- Preguntas Frecuentes -->
            <div class="relative group">
                <div class="absolute inset-0 bg-gradient-to-r from-yellow-500/20 to-brand-orange-500/20 rounded-2xl blur-xl group-hover:from-yellow-500/30 group-hover:to-brand-orange-500/30 transition-all"></div>
                <div class="relative bg-white border border-slate-200 rounded-2xl p-8 hover:shadow-lg transition-all">
                    <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
                        <i class="fa fa-question-circle text-yellow-600"></i> Preguntas Frecuentes
                    </h3>

                    <div class="space-y-4">
                        <details class="group/detail border border-slate-200 rounded-lg p-4 hover:border-slate-300 transition-all bg-slate-50">
                            <summary class="flex justify-between items-center cursor-pointer font-bold text-slate-900">
                                ¿Cuál es el costo total del programa?
                                <i class="fa fa-chevron-down group-open/detail:rotate-180 transition-transform text-brand-orange-500"></i>
                            </summary>
                            <p class="text-slate-600 text-sm mt-4">El costo total del diplomado es de S/. 2,700 distribuido en 6 cuotas de S/. 450 cada una.</p>
                        </details>

                        <details class="group/detail border border-slate-200 rounded-lg p-4 hover:border-slate-300 transition-all bg-slate-50">
                            <summary class="flex justify-between items-center cursor-pointer font-bold text-slate-900">
                                ¿Hay descuentos por pronto pago?
                                <i class="fa fa-chevron-down group-open/detail:rotate-180 transition-transform text-brand-orange-500"></i>
                            </summary>
                            <p class="text-slate-600 text-sm mt-4">Sí, contamos con descuentos especiales si pagas en los primeros 5 días de cada mes. Consulta con nuestros asesores.</p>
                        </details>

                        <details class="group/detail border border-slate-200 rounded-lg p-4 hover:border-slate-300 transition-all bg-slate-50">
                            <summary class="flex justify-between items-center cursor-pointer font-bold text-slate-900">
                                ¿Qué pasa si no pago a tiempo?
                                <i class="fa fa-chevron-down group-open/detail:rotate-180 transition-transform text-brand-orange-500"></i>
                            </summary>
                            <p class="text-slate-600 text-sm mt-4">Los pagos vencidos pueden afectar tu acceso a la plataforma. Te recomendamos ponerte en contacto con nosotros para coordinar un plan de pagos.</p>
                        </details>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Check if user is logged in
        const userStr = localStorage.getItem('portalUser');
        if (!userStr) {
            window.location.href = '/portal';
        }

        // Logout
        const logoutBtn = document.getElementById('logoutBtn');
        logoutBtn?.addEventListener('click', () => {
            localStorage.removeItem('portalUser');
            window.location.href = '/portal';
        });
    </script>
</Layout>
