---
import Layout from '../../layouts/Layout.astro';

const programs = [
    {
        program: "Diplomado",
        specialty: "En Gestión Educativa",
        period: "2026-II",
        status: "En Curso",
        progress: 75
    },
    {
        program: "Especialización",
        specialty: "En Liderazgo Pedagógico",
        period: "2025-IV",
        status: "Completado",
        progress: 100
    },
    {
        program: "Diplomado",
        specialty: "En Docencia Universitaria",
        period: "2024-III",
        status: "Completado",
        progress: 100
    },
];
---

<Layout title="Información Académica | Portal de Estudiantes">
    <div class="min-h-screen bg-white">

        <!-- Header -->
        <header class="bg-brand-orange-500 sticky top-0 z-40 shadow-md">
            <div class="max-w-7xl mx-auto flex items-center justify-between px-4 md:px-6 py-4">
                <div class="flex items-center gap-4">
                    <a href="/portal/dashboard" class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors text-white">
                        <i class="fa fa-arrow-left text-lg"></i>
                    </a>
                    <h1 class="text-xl font-bold text-white">Información Académica</h1>
                </div>
                <button id="logoutBtn" class="px-4 py-2 rounded-lg text-white font-semibold text-sm hover:bg-white/10 transition-colors border border-white/20">
                    Salir
                </button>
            </div>
        </header>

        <main class="w-full p-4 md:p-8 overflow-x-hidden max-w-6xl mx-auto">
            <!-- Historial de Programas -->
            <div class="mb-8">
                <h2 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-2">
                    <i class="fa fa-book text-brand-orange-500"></i> Historial de Programas Académicos
                </h2>

                <div class="space-y-4">
                    {programs.map((prog, index) => (
                        <div class="group relative" data-aos="fade-up" data-aos-delay={index * 100}>
                            <div class={`absolute inset-0 bg-gradient-to-r ${
                                prog.status === "En Curso"
                                    ? "from-brand-orange-500 to-brand-orange-600"
                                    : "from-green-500 to-emerald-600"
                            } rounded-2xl opacity-0 group-hover:opacity-100 blur transition-all duration-300`}></div>

                            <div class={`relative bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-lg transition-all ${
                                prog.status === "En Curso" ? "ring-1 ring-brand-orange-500" : ""
                            }`}>
                                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2 mb-3">
                                            <h3 class="text-xl md:text-2xl font-black text-slate-900">{prog.program}</h3>
                                            <span class={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold ${
                                                prog.status === "En Curso"
                                                    ? "bg-brand-orange-100 text-brand-orange-700"
                                                    : "bg-green-100 text-green-700"
                                            }`}>
                                                <i class={`fa ${prog.status === "En Curso" ? "fa-hourglass-half" : "fa-check-circle"}`}></i>
                                                {prog.status}
                                            </span>
                                        </div>

                                        <p class="text-slate-700 font-semibold mb-3">{prog.specialty}</p>

                                        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                                            <div>
                                                <p class="text-xs text-slate-500 font-semibold mb-1">PERÍODO</p>
                                                <p class="text-lg font-black text-slate-900">{prog.period}</p>
                                            </div>

                                            {prog.status === "En Curso" && (
                                                <div class="flex-1">
                                                    <p class="text-xs text-slate-500 font-semibold mb-2">PROGRESO</p>
                                                    <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden border border-slate-300">
                                                        <div
                                                            class="bg-gradient-to-r from-brand-orange-500 to-brand-orange-600 h-full rounded-full transition-all duration-1000"
                                                            style={`width: ${prog.progress}%;`}
                                                        ></div>
                                                    </div>
                                                    <p class="text-xs text-slate-500 mt-1">{prog.progress}% completado</p>
                                                </div>
                                            )}
                                        </div>
                                    </div>

                                    <div class="flex flex-col md:flex-col gap-3 flex-shrink-0">
                                        <div class={`w-16 h-16 rounded-xl flex items-center justify-center ${
                                            prog.status === "En Curso"
                                                ? "bg-brand-orange-100 border border-brand-orange-300"
                                                : "bg-green-100 border border-green-300"
                                        }`}>
                                            <i class={`fa fa-graduation-cap text-3xl ${prog.status === "En Curso" ? "text-brand-orange-600" : "text-green-600"}`}></i>
                                        </div>

                                        {prog.status === "Completado" ? (
                                            <a href="#" class="px-4 py-2.5 rounded-lg bg-green-600 text-white font-bold text-sm hover:bg-green-700 transition-colors text-center whitespace-nowrap flex items-center justify-center gap-2">
                                                <i class="fa fa-download"></i> Certificado
                                            </a>
                                        ) : (
                                            <button disabled class="px-4 py-2.5 rounded-lg bg-slate-200 text-slate-400 font-bold text-sm cursor-not-allowed text-center whitespace-nowrap flex items-center justify-center gap-2">
                                                <i class="fa fa-lock"></i> Bloqueado
                                            </button>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Progreso -->
            <div class="bg-white rounded-xl border border-slate-200 p-8">
                <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
                    <i class="fa fa-chart-pie text-brand-orange-500"></i> Progreso del Programa
                </h3>

                <div class="space-y-6">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <p class="text-sm font-bold text-slate-900">Cursos Completados</p>
                            <p class="text-sm font-bold text-brand-orange-500">6 de 8</p>
                        </div>
                        <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden border border-slate-300">
                            <div class="bg-brand-orange-500 h-full rounded-full transition-all duration-1000" style="width: 75%;"></div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <p class="text-sm font-bold text-slate-900">Créditos Obtenidos</p>
                                <p class="text-sm font-bold text-brand-orange-500">22 de 32</p>
                            </div>
                            <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden border border-slate-300">
                                <div class="bg-gradient-to-r from-brand-orange-500 to-brand-maroon-600 h-full rounded-full transition-all duration-1000" style="width: 69%;"></div>
                            </div>
                        </div>
                    </div>

                    <p class="text-sm text-slate-700 mt-6 p-4 rounded-lg bg-blue-50 border border-blue-200">
                        <i class="fa fa-calendar text-brand-orange-500 mr-2"></i>
                        Estimado de graduación: <strong class="text-slate-900">Enero 2025</strong>
                    </p>
                </div>
            </div>

        </main>
    </div>

    <script>
        // Check if user is logged in
        const userStr = localStorage.getItem('portalUser');
        if (!userStr) {
            window.location.href = '/portal';
        }

        // Logout
        const logoutBtn = document.getElementById('logoutBtn');
        logoutBtn?.addEventListener('click', () => {
            localStorage.removeItem('portalUser');
            window.location.href = '/portal';
        });
    </script>
</Layout>
