---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const programs = [
    {
        title: "Preparación para Concurso de Ascenso",
        target: "Docentes que aspiran a ascender",
        desc: "Preparación integral para superar las pruebas de conocimiento pedagógico y especializado del MINEDU.",
        topics: ["Ley de Reforma Magisterial", "Estándares Pedagógicos", "Prueba de Desempeño", "Portafolio Digital"]
    },
    {
        title: "Preparación para Concurso Público de Docentes",
        target: "Candidatos a plazas docentes",
        desc: "Entrenamiento exhaustivo para enfrentar el examen de nombramiento docente con confianza.",
        topics: ["Conocimiento Pedagógico", "Área Disciplinar", "Prueba Escrita", "Entrevista Panel"]
    },
    {
        title: "Preparación para Especialista UGEL",
        target: "Profesionales de educación",
        desc: "Formación especializada para acceder a cargos de especialista en UGEL y Dirección Regional.",
        topics: ["Gestión Educativa", "Normativa MINEDU", "Análisis de Políticas", "Evaluación Institucional"]
    },
];
---

<Layout title="Preparación | Elias Capellan">
    <Navigation />

    <main class="pt-32">
        <!-- Hero Section -->
        <section class="py-16 relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16" data-aos="fade-up">
                    <h1 class="text-5xl md:text-6xl font-black text-slate-900 mb-6">
                        Preparación para <span class="text-gradient">Concursos MINEDU</span>
                    </h1>
                    <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
                        Programas especializados y enfocados para que superes exitosamente los concursos de ascenso, nombramiento y especialistas.
                    </p>
                </div>

                <!-- Programs Grid -->
                <div class="grid md:grid-cols-3 gap-8">
                    {programs.map((prog, index) => (
                        <div class="bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 group" data-aos="fade-up" data-aos-delay={index * 100}>
                            <!-- Header -->
                            <div class="h-32 bg-gradient-to-br from-brand-maroon-950 to-brand-orange-600 relative overflow-hidden flex items-center justify-center">
                                <i class="fa fa-trophy text-white text-5xl opacity-20"></i>
                            </div>

                            <!-- Content -->
                            <div class="p-8">
                                <h3 class="text-xl font-bold text-slate-900 mb-2">{prog.title}</h3>

                                <div class="mb-4 pb-4 border-b-2 border-brand-orange-200">
                                    <p class="text-xs font-bold text-brand-orange-600 uppercase tracking-widest mb-1">Dirigido a</p>
                                    <p class="text-slate-600 font-semibold">{prog.target}</p>
                                </div>

                                <p class="text-slate-600 text-sm mb-6 leading-relaxed">{prog.desc}</p>

                                <!-- Topics -->
                                <div class="mb-6">
                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Temas Cubiertos</p>
                                    <ul class="space-y-2">
                                        {prog.topics.map(topic => (
                                            <li class="flex items-start gap-2 text-xs text-slate-600">
                                                <i class="fa fa-chevron-right text-brand-orange-500 mt-1 flex-shrink-0"></i>
                                                {topic}
                                            </li>
                                        ))}
                                    </ul>
                                </div>

                                <!-- Button -->
                                <a href="/contacto" class="block w-full py-3 rounded-lg bg-gradient-to-r from-brand-maroon-950 to-brand-maroon-900 text-white font-bold text-center hover:shadow-lg transition-all active:scale-95">
                                    Solicitar Información
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Success Stories Section -->
        <section class="py-24 relative overflow-hidden bg-gradient-to-r from-brand-orange-500 to-brand-maroon-600">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>

            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="text-center text-white mb-16" data-aos="fade-up">
                    <h2 class="text-4xl md:text-5xl font-black mb-6">
                        Historias de <span class="text-brand-orange-100">Éxito</span>
                    </h2>
                    <p class="text-lg text-white/90">
                        Cientos de docentes han alcanzado sus objetivos gracias a nuestros programas de preparación
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    {[
                        { name: "Dra. Rosa Martínez", achievement: "Ascendió a especialista UGEL", year: "2024" },
                        { name: "Prof. Carlos López", achievement: "Ganador de concurso de docentes", year: "2024" },
                        { name: "Lic. Ana García", achievement: "Directora de institución pública", year: "2024" },
                    ].map(story => (
                        <div class="bg-white/20 backdrop-blur rounded-2xl p-6 border border-white/20 text-center text-white" data-aos="fade-up">
                            <div class="w-16 h-16 rounded-full bg-white/30 flex items-center justify-center mx-auto mb-4">
                                <i class="fa fa-user text-2xl"></i>
                            </div>
                            <h4 class="font-bold text-lg mb-2">{story.name}</h4>
                            <p class="text-sm text-white/90 mb-3">{story.achievement}</p>
                            <span class="text-xs text-white/70">{story.year}</span>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-6">
                <div class="bg-brand-maroon-950 rounded-3xl p-12 md:p-20 relative overflow-hidden" data-aos="flip-up">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-brand-orange-500/10 rounded-full -mr-32 -mt-32 blur-3xl"></div>

                    <div class="relative z-10 text-center">
                        <h3 class="text-3xl md:text-5xl font-black text-white mb-6">
                            ¿Listo para tu siguiente paso?
                        </h3>
                        <p class="text-brand-orange-100 text-lg mb-8 max-w-2xl mx-auto">
                            Contacta con nuestros asesores y conoce el programa de preparación ideal para ti.
                        </p>
                        <a href="/contacto" class="inline-flex items-center gap-3 px-12 py-5 rounded-2xl bg-white text-brand-maroon-950 font-black text-lg hover:bg-slate-50 hover:shadow-xl hover:-translate-y-1 transition-all active:scale-95">
                            Comenzar Ahora
                            <i class="fa fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
