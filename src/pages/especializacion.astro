---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const specializations = [
    {
        title: "Especialización en Evaluación Educativa",
        focus: "Evaluación Diagnóstica, Formativa y Sumativa",
        desc: "Domina metodologías de evaluación integral para medir competencias y aprendizajes significativos en el aula."
    },
    {
        title: "Especialización en Liderazgo Pedagógico",
        focus: "Liderazgo, Visión Compartida, Mejora Continua",
        desc: "Desarrolla habilidades de liderazgo transformacional para impactar positivamente en tu institución educativa."
    },
    {
        title: "Especialización en Diseño Curricular",
        focus: "Currículo Basado en Competencias",
        desc: "Aprende a diseñar y adaptar currículos que respondan a las necesidades actuales de la sociedad."
    },
    {
        title: "Especialización en Didáctica de Contenidos",
        focus: "Metodologías Innovadoras por Área",
        desc: "Estrategias pedagógicas específicas para enseñanza efectiva de diferentes disciplinas académicas."
    },
];
---

<Layout title="Especialización | Elias Capellan">
    <Navigation />

    <main class="pt-32">
        <!-- Hero Section -->
        <section class="py-16 relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16" data-aos="fade-up">
                    <h1 class="text-5xl md:text-6xl font-black text-slate-900 mb-6">
                        Especialización <span class="text-gradient">de Alto Nivel</span>
                    </h1>
                    <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
                        Programas de profundización en áreas específicas para profesionales que desean dominar disciplinas clave en educación moderna.
                    </p>
                </div>

                <!-- Specializations Grid -->
                <div class="grid md:grid-cols-2 gap-8">
                    {specializations.map((spec, index) => (
                        <div class="relative group" data-aos="fade-up" data-aos-delay={index * 100}>
                            <div class="absolute -inset-1 bg-gradient-to-r from-brand-orange-400 to-brand-maroon-600 rounded-3xl opacity-25 group-hover:opacity-100 transition duration-300 blur"></div>

                            <div class="relative bg-white rounded-3xl p-8 h-full">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-orange-400 to-brand-maroon-600 flex items-center justify-center mb-6">
                                    <i class="fa fa-star text-white"></i>
                                </div>

                                <h3 class="text-2xl font-bold text-slate-900 mb-3">{spec.title}</h3>

                                <div class="mb-4 pb-4 border-b border-slate-200">
                                    <p class="text-xs font-bold text-brand-orange-600 uppercase tracking-widest mb-1">Enfoque Principal</p>
                                    <p class="text-slate-700 font-semibold">{spec.focus}</p>
                                </div>

                                <p class="text-slate-600 mb-6 leading-relaxed">{spec.desc}</p>

                                <div class="flex gap-3">
                                    <a href="/contacto" class="flex-1 py-3 rounded-lg bg-brand-maroon-950 text-white font-bold text-center text-sm hover:bg-brand-maroon-900 transition-colors">
                                        Información
                                    </a>
                                    <a href="/inscripcion" class="flex-1 py-3 rounded-lg bg-brand-orange-500 text-white font-bold text-center text-sm hover:bg-brand-orange-600 transition-colors">
                                        Inscribirse
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Why Section -->
        <section class="py-24 relative overflow-hidden bg-slate-50">
            <div class="absolute top-0 left-0 w-96 h-96 bg-brand-maroon-500/5 rounded-full -ml-48 -mt-48 blur-3xl"></div>

            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div data-aos="fade-right">
                        <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6">
                            Especialización que <span class="text-gradient">Marca Diferencia</span>
                        </h2>
                        <p class="text-lg text-slate-600 mb-6 leading-relaxed">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                        </p>
                        <ul class="space-y-4">
                            {[
                                "Certificación de postgrado reconocida",
                                "Docentes investigadores con PhD",
                                "Participación en congresos internacionales",
                                "Proyectos aplicados en contexto real",
                                "Red de egresados de elite"
                            ].map(item => (
                                <li class="flex items-center gap-3 text-slate-700 font-medium">
                                    <div class="w-6 h-6 rounded-full bg-brand-orange-500 flex items-center justify-center flex-shrink-0">
                                        <i class="fa fa-check text-white text-xs"></i>
                                    </div>
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="relative group" data-aos="fade-left">
                        <div class="absolute -inset-4 bg-brand-maroon-500/10 rounded-[2.5rem] blur-2xl group-hover:bg-brand-maroon-500/20 transition-colors duration-500"></div>
                        <div class="relative aspect-square rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-gradient-to-br from-brand-orange-400 to-brand-maroon-600 flex items-center justify-center">
                            <i class="fa fa-lightbulb text-white text-8xl opacity-30"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
